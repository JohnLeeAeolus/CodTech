rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========= Helper functions =========
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(uid()));
    }

    function userRole() {
      return hasUserDoc() ? get(/databases/$(database)/documents/users/$(uid())).data.role : null;
    }

    // Backward-compatible role inference: if users/{uid} is missing, fall back
    // to presence of UID-profile docs.
    function isFaculty() {
      return isAuthenticated() && (
        userRole() == 'faculty' ||
        userRole() == 'Faculty' ||
        (userRole() is string && userRole().matches('^\\s*(faculty|Faculty)\\s*$')) ||
        exists(/databases/$(database)/documents/faculty/$(uid()))
      );
    }

    function isStudent() {
      return isAuthenticated() && (
        userRole() == 'student' ||
        userRole() == 'Student' ||
        (userRole() is string && userRole().matches('^\\s*(student|Student)\\s*$')) ||
        exists(/databases/$(database)/documents/students/$(uid()))
      );
    }

    function courseOwnedByFaculty(courseId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/courses/$(courseId))
        && (
          get(/databases/$(database)/documents/courses/$(courseId)).data.facultyId == uid() ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.facultyUid == uid() ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.instructorId == uid() ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.ownerId == uid() ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.createdBy == uid()
        );
    }

    function assignmentOwnedByFaculty(assignmentId) {
      return isAuthenticated()
        && assignmentId != null
        && exists(/databases/$(database)/documents/assignments/$(assignmentId))
        && courseOwnedByFaculty(get(/databases/$(database)/documents/assignments/$(assignmentId)).data.courseId);
    }

    function courseIsUnowned(courseData) {
      // Treat missing facultyId as unowned (common in seeded datasets).
      return !courseData.keys().hasAny(['facultyId'])
        || courseData.facultyId == null
        || courseData.facultyId == ''
        || (courseData.facultyId is string && courseData.facultyId.matches('^\\s+$'));
    }

    function quizOwnedByFaculty(quizId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/quizzes/$(quizId))
        && courseOwnedByFaculty(get(/databases/$(database)/documents/quizzes/$(quizId)).data.courseId);
    }

    // ========= Canonical user doc =========
    match /users/{userId} {
      allow read, create, update, delete: if isAuthenticated() && userId == uid();
    }

    // ========= Profiles =========
    // Support legacy random IDs by also checking stored uid field.
    match /students/{docId} {
      allow read: if isStudent() && (docId == uid() || resource.data.uid == uid());
      allow create: if isStudent() && request.resource.data.uid == uid();
      allow update: if isStudent() && (docId == uid() || resource.data.uid == uid());
      allow delete: if isStudent() && (docId == uid() || resource.data.uid == uid());
    }

    match /faculty/{docId} {
      allow read: if isFaculty() && (docId == uid() || resource.data.uid == uid());
      allow create: if isFaculty() && request.resource.data.uid == uid();
      allow update: if isFaculty() && (docId == uid() || resource.data.uid == uid());
      allow delete: if isFaculty() && (docId == uid() || resource.data.uid == uid());
    }

    // ========= Courses =========
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isFaculty() && request.resource.data.facultyId == uid();
      // Allow the owning faculty to manage the course.
      // Also allow a one-time "claim" of unowned courses where facultyId is missing/null.
      allow update: if isFaculty() && (
        resource.data.facultyId == uid() ||
        (
          courseIsUnowned(resource.data) &&
          request.resource.data.facultyId == uid() &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['facultyId', 'updatedAt'])
        )
      );
      allow delete: if isFaculty() && resource.data.facultyId == uid();
    }

    // ========= Enrollments =========
    // Students can create/delete their own enrollments; faculty can read enrollments
    // for their own courses.
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == uid() ||
        (isFaculty() && courseOwnedByFaculty(resource.data.courseId))
      );
      allow create: if isStudent() && request.resource.data.studentId == uid();
      allow delete: if isStudent() && resource.data.studentId == uid();
      allow update: if false;
    }

    // ========= Assignments =========
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if isFaculty()
        && request.resource.data.facultyId == uid()
        && courseOwnedByFaculty(request.resource.data.courseId);
      allow update, delete: if isFaculty() && courseOwnedByFaculty(resource.data.courseId);
    }

    // ========= Quizzes =========
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow create: if isFaculty()
        && request.resource.data.facultyId == uid()
        && courseOwnedByFaculty(request.resource.data.courseId);
      allow update, delete: if isFaculty() && courseOwnedByFaculty(resource.data.courseId);
    }

    // ========= Announcements =========
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create: if isFaculty()
        && request.resource.data.facultyId == uid()
        && courseOwnedByFaculty(request.resource.data.courseId);
      allow update, delete: if isFaculty() && courseOwnedByFaculty(resource.data.courseId);
    }

    // ========= Submissions =========
    // Students can create/read their own; faculty can read/update submissions for their courses.
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == uid() ||
        (isFaculty() && (courseOwnedByFaculty(resource.data.courseId) || assignmentOwnedByFaculty(resource.data.assignmentId)))
      );
      allow create: if isStudent() && request.resource.data.studentId == uid();
      allow update: if isFaculty() && (courseOwnedByFaculty(resource.data.courseId) || assignmentOwnedByFaculty(resource.data.assignmentId));
      allow delete: if isStudent() && resource.data.studentId == uid();
    }

    // ========= Quiz submissions =========
    match /quizSubmissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == uid() ||
        (isFaculty() && quizOwnedByFaculty(resource.data.quizId))
      );
      allow create: if isStudent() && request.resource.data.studentId == uid();
      allow update: if isFaculty() && quizOwnedByFaculty(resource.data.quizId);
      allow delete: if isStudent() && resource.data.studentId == uid();
    }

    // ========= Grades =========
    match /grades/{gradeId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == uid() ||
        (isFaculty() && courseOwnedByFaculty(resource.data.courseId))
      );
      allow create: if isFaculty() && courseOwnedByFaculty(request.resource.data.courseId);
      allow update: if isFaculty() && courseOwnedByFaculty(resource.data.courseId);
      allow delete: if isFaculty() && courseOwnedByFaculty(resource.data.courseId);
    }

    // ========= Schedule =========
    match /schedule/{scheduleId} {
      allow read: if isAuthenticated();
      allow create: if isFaculty() && courseOwnedByFaculty(request.resource.data.courseId);
      allow update: if isFaculty() && courseOwnedByFaculty(resource.data.courseId);
      allow delete: if isFaculty() && courseOwnedByFaculty(resource.data.courseId);
    }

    // ========= Materials =========
    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow create: if isFaculty() && courseOwnedByFaculty(request.resource.data.courseId);
      allow update: if isFaculty() && courseOwnedByFaculty(resource.data.courseId);
      allow delete: if isFaculty() && courseOwnedByFaculty(resource.data.courseId);
    }

    // ========= Messages =========
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (resource.data.senderId == uid() || resource.data.recipientId == uid());
      allow create: if isAuthenticated() && request.resource.data.senderId == uid();
      allow update: if isAuthenticated() && resource.data.recipientId == uid();
      allow delete: if isAuthenticated() && (resource.data.senderId == uid() || resource.data.recipientId == uid());
    }
    
    // Catch-all: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

